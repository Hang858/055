	}
	fmt.Printf("✓ 抗量子签名验证成功: %s 由 %s 正确签名\n", cert.Subject.CommonName, parent.Subject.CommonName)

	fmt.Printf("✓ 传统证书签名验证成功: %s 由 %s 正确签名\n", cert.Subject.CommonName, parent.Subject.CommonName)
	return nil
