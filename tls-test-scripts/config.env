# TLS 测试脚本配置（客户端视角）
# client ：脚本全部在本机执行，客户端进程访问远端已启动的服务端端点
# server ：服务端侧用例（TLS-2-5、TLS-1-13）在服务端本机执行
MODE=${MODE:-client}

# 服务端地址与固定端点（由服务端 tls-test-scripts/server-endpoints.sh 一次性启动）
SERVER_HOST=${SERVER_HOST:-192.168.2.165}
SERVER_PORT=${SERVER_PORT:-8080}                  # 全部非 HQC 组
SERVER_PORT_HQC=${SERVER_PORT_HQC:-8181}          # 全部 HQC 组
SERVER_PORT_POLICY=${SERVER_PORT_POLICY:-8082}    # 协商策略：X25519,X25519Kyber1024Draft00
SERVER_PORT_BENCH=${SERVER_PORT_BENCH:-8099}      # tlsbench 服务端
SERVER_PORT_EXPIRED=${SERVER_PORT_EXPIRED:-8111}  # 过期证书端点（TLS-1-10）

# 本机程序与证书（相对项目根目录）
BIN_DIR=.build
CERTS_DIR=.build/certs
CAPTURE_IFACE=${CAPTURE_IFACE:-eno2}              # 跨机抓包用的本机网卡
TRACE=${TRACE:-0}                                 # 1=把实际执行的命令展开打印到终端（截图留证）
# TRACE_ALL=${TRACE_ALL:-0}                       # 1=连 shell 内部过程也 set -x

# 服务端侧用例（TLS-2-5、TLS-1-13）
# RUN_SERVER_SIDE=1：run_all 通过 SSH 在服务端执行并取回结果；0：跳过；local：本机执行
RUN_SERVER_SIDE=${RUN_SERVER_SIDE:-1}
SERVER_SSH=${SERVER_SSH:-xgs-server}              # 已配置免密 SSH 的主机别名或 user@host
SERVER_DIR=${SERVER_DIR:-/opt/pqc-tls-test}       # 服务端部署目录

# 用例规模（可按机器性能调整）
PERF_N=200
CONCURRENCY_N=1000
CONCURRENCY_C=50
LOAD_LOOPS=150
NETEM_N=1000
NETEM_C=50
NETEM_FULL=${NETEM_FULL:-1}          # 1=跑四种方案×四档时延；0=只跑 ClassicKEX 四档
RUN_MODE_MATRIX=${RUN_MODE_MATRIX:-1}     # TLS-1-13 的四模式矩阵，1=执行

# 编译用例使用的 Go（打补丁的 1.22.12）
GO_BIN=.build/go/bin/go
