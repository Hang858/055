+func (hs *clientHandshakeStateTLS13) deriveAuthenticatedHandshake() error {
+	c := hs.c
+	if len(hs.persistentssKEM) == 0 && len(hs.persistentssKEM_Client) == 0 {
+		c.sendAlert(alertInternalError)
+		return errors.New("tls: missing KEM secrets for authenticated handshake")
+	}
