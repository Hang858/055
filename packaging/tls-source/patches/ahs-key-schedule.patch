+import (
+	"bytes"
+	"crypto/internal/fips140/tls13"
+	"crypto/sha256"
+	"testing"
+)
+
+func TestAuthenticatedHandshakeSecret(t *testing.T) {
+	hs := tls13.NewEarlySecret(sha256.New, nil).HandshakeSecret([]byte("ecdh"))
+	ahs := hs.AuthenticatedHandshakeSecret([]byte("kem-secret"))
+
+	clientAHS := ahs.ClientAuthenticatedHandshakeTrafficSecret(sha256.New())
+	serverAHS := ahs.ServerAuthenticatedHandshakeTrafficSecret(sha256.New())
+	if bytes.Equal(clientAHS, serverAHS) {
+		t.Fatal("client and server AHS traffic secrets must differ")
+	}
+	if bytes.Equal(clientAHS, hs.ClientHandshakeTrafficSecret(sha256.New())) {
+		t.Fatal("AHS traffic secret must differ from the initial handshake secret")
+	}
+	if !bytes.Equal(clientAHS, ahs.ClientAuthenticatedHandshakeTrafficSecret(sha256.New())) {
+		t.Fatal("AHS derivation must be deterministic")
+	}
+	if !bytes.Equal(clientAHS, hs.AuthenticatedHandshakeSecret([]byte("kem-secret")).ClientAuthenticatedHandshakeTrafficSecret(sha256.New())) {
+		t.Fatal("AHS derivation from the same inputs must be stable")
+	}
+
+	app := ahs.MasterSecret().ClientApplicationTrafficSecret(sha256.New())
+	if bytes.Equal(app, hs.MasterSecret().ClientApplicationTrafficSecret(sha256.New())) {
+		t.Fatal("AHS-derived application secret must differ from the legacy master")
+	}
+}
