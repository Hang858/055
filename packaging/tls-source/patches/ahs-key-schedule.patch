+// AuthenticatedHandshakeSecret 是 FA-TLS 两阶段密钥调度的第二阶段：
+// 在证书/KEM 认证完成后，用初始 HandshakeSecret 和 KEM 认证秘密再
+// HKDF-Extract 一次，得到 AHS。
+type AuthenticatedHandshakeSecret struct {
+	secret []byte
+	hash   func() hash.Hash
+}
+
+// AuthenticatedHandshakeSecret derives AHS from the initial handshake secret
+// and the certificate-based KEM secret.
+func (s *HandshakeSecret) AuthenticatedHandshakeSecret(kemSecret []byte) *AuthenticatedHandshakeSecret {
+	derived := deriveSecret(s.hash, s.secret, "derived", nil)
+	return &AuthenticatedHandshakeSecret{
+		secret: extract(s.hash, kemSecret, derived),
+		hash:   s.hash,
+	}
+}
+
+// ClientAuthenticatedHandshakeTrafficSecret derives the client authenticated
+// handshake traffic secret from AHS and the authenticated transcript.
+func (s *AuthenticatedHandshakeSecret) ClientAuthenticatedHandshakeTrafficSecret(transcript hash.Hash) []byte {
+	return deriveSecret(s.hash, s.secret, "fa c ahs traffic", transcript)
+}
+
+// ServerAuthenticatedHandshakeTrafficSecret derives the server authenticated
+// handshake traffic secret from AHS and the authenticated transcript.
+func (s *AuthenticatedHandshakeSecret) ServerAuthenticatedHandshakeTrafficSecret(transcript hash.Hash) []byte {
+	return deriveSecret(s.hash, s.secret, "fa s ahs traffic", transcript)
+}
+
+// MasterSecret derives the master secret from AHS, mirroring the TLS 1.3
+// HandshakeSecret.MasterSecret derivation.
+func (s *AuthenticatedHandshakeSecret) MasterSecret() *MasterSecret {
+	derived := deriveSecret(s.hash, s.secret, "derived", nil)
+	return &MasterSecret{
+		secret: extract(s.hash, nil, derived),
+		hash:   s.hash,
+	}
+}
