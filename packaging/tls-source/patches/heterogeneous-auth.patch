--- a/src/crypto/tls/auth_modes_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/src/crypto/tls/auth_modes_test.go	2026-11-20 16:50:04.791631978 +0800
@@ -0,0 +1,60 @@
+package tls
+
+import "testing"
+
+func TestAuthModes(t *testing.T) {
+	tests := []struct {
+		name        string
+		c           *Config
+		wantClient  uint16
+		wantServer  uint16
+		wantPresent bool
+	}{
+		{
+			name:       "legacy derives from ProtocolType",
+			c:          &Config{ProtocolType: 21},
+			wantClient: AuthKEM,
+			wantServer: AuthKEM,
+		},
+		{
+			name:        "explicit heterogeneous pair",
+			c:           &Config{ProtocolType: 21, ClientAuthMode: AuthSig, ServerAuthMode: AuthKEM},
+			wantClient:  AuthSig,
+			wantServer:  AuthKEM,
+			wantPresent: true,
+		},
+		{
+			name:        "reachable KEM-Sig pair",
+			c:           &Config{ProtocolType: 11, ClientAuthMode: AuthKEM, ServerAuthMode: AuthSig},
+			wantClient:  AuthKEM,
+			wantServer:  AuthSig,
+			wantPresent: true,
+		},
+		{
+			name:        "only server auth set",
+			c:           &Config{ProtocolType: 21, ServerAuthMode: AuthKEM},
+			wantClient:  AuthKEM,
+			wantServer:  AuthKEM,
+			wantPresent: true,
+		},
+	}
+	for _, tc := range tests {
+		client, server, present := tc.c.authModes()
+		if client != tc.wantClient || server != tc.wantServer || present != tc.wantPresent {
+			t.Errorf("%s: got (%d,%d,%v), want (%d,%d,%v)", tc.name, client, server, present, tc.wantClient, tc.wantServer, tc.wantPresent)
+		}
+	}
+}
+
+func TestAuthModeValid(t *testing.T) {
+	for _, a := range []uint16{AuthClassic, AuthSig, AuthKEM} {
+		if !authModeValid(a) {
+			t.Errorf("authModeValid(%d) = false", a)
+		}
+	}
+	for _, a := range []uint16{1, 5, 19, 21, 30, 99} {
+		if authModeValid(a) {
+			t.Errorf("authModeValid(%d) = true", a)
+		}
+	}
+}
