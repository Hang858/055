diff -ruN .build/patch-seq7/src/crypto/tls/pq_kex.go .build/extracted/go_kemtls/src/crypto/tls/pq_kex.go
--- a/src/crypto/tls/pq_kex.go	1970-01-01 08:00:00.000000000 +0800
+++ b/src/crypto/tls/pq_kex.go	2026-11-22 12:13:21.580104196 +0800
@@ -0,0 +1,112 @@
+package tls
+
+import (
+	"crypto/mlkem"
+	"fmt"
+
+	"github.com/cloudflare/circl/kem"
+	"github.com/cloudflare/circl/kem/kyber/kyber768"
+)
+
+// pqKEX 封装混合 KEX / ServerKeyGen 使用的 KEM 操作。KEM 证书路径走
+// crypto/pq 注册表，这里只处理 TLS key_share 侧的临时密钥。
+func pqKEXAlgName(cfg string) string {
+	if cfg == "" {
+		return "Kyber768"
+	}
+	return cfg
+}
+
+func pqKEXSizes(alg string) (pk, ct int, err error) {
+	switch alg {
+	case "Kyber768":
+		return kyber768.PublicKeySize, kyber768.CiphertextSize, nil
+	case "ML-KEM-768":
+		return 1184, 1088, nil
+	case "ML-KEM-1024":
+		return 1568, 1568, nil
+	default:
+		return 0, 0, fmt.Errorf("tls: unsupported KEX KEM algorithm %q", alg)
+	}
+}
+
+func pqKEXGenerate(alg string) (pub []byte, priv any, err error) {
+	switch alg {
+	case "Kyber768":
+		pk, sk, err := kyber768.Scheme().GenerateKeyPair()
+		if err != nil {
+			return nil, nil, err
+		}
+		raw, err := pk.MarshalBinary()
+		if err != nil {
+			return nil, nil, err
+		}
+		return raw, sk, nil
+	case "ML-KEM-768":
+		dk, err := mlkem.GenerateKey768()
+		if err != nil {
+			return nil, nil, err
+		}
+		return dk.EncapsulationKey().Bytes(), dk, nil
+	case "ML-KEM-1024":
+		dk, err := mlkem.GenerateKey1024()
+		if err != nil {
+			return nil, nil, err
+		}
+		return dk.EncapsulationKey().Bytes(), dk, nil
+	default:
+		return nil, nil, fmt.Errorf("tls: unsupported KEX KEM algorithm %q", alg)
+	}
+}
+
+func pqKEXEncapsulate(alg string, pub []byte) (ct, ss []byte, err error) {
+	switch alg {
+	case "Kyber768":
+		pk, err := kyber768.Scheme().UnmarshalBinaryPublicKey(pub)
+		if err != nil {
+			return nil, nil, err
+		}
+		return kyber768.Scheme().Encapsulate(pk)
+	case "ML-KEM-768":
+		ek, err := mlkem.NewEncapsulationKey768(pub)
+		if err != nil {
+			return nil, nil, err
+		}
+		ss, ct = ek.Encapsulate()
+		return ct, ss, nil
+	case "ML-KEM-1024":
+		ek, err := mlkem.NewEncapsulationKey1024(pub)
+		if err != nil {
+			return nil, nil, err
+		}
+		ss, ct = ek.Encapsulate()
+		return ct, ss, nil
+	default:
+		return nil, nil, fmt.Errorf("tls: unsupported KEX KEM algorithm %q", alg)
+	}
+}
+
+func pqKEXDecapsulate(alg string, priv any, ct []byte) ([]byte, error) {
+	switch alg {
+	case "Kyber768":
+		sk, ok := priv.(kem.PrivateKey)
+		if !ok {
+			return nil, fmt.Errorf("tls: invalid Kyber private key type")
+		}
+		return kyber768.Scheme().Decapsulate(sk, ct)
+	case "ML-KEM-768":
+		dk, ok := priv.(*mlkem.DecapsulationKey768)
+		if !ok {
+			return nil, fmt.Errorf("tls: invalid ML-KEM-768 private key type")
+		}
+		return dk.Decapsulate(ct)
+	case "ML-KEM-1024":
+		dk, ok := priv.(*mlkem.DecapsulationKey1024)
+		if !ok {
+			return nil, fmt.Errorf("tls: invalid ML-KEM-1024 private key type")
+		}
+		return dk.Decapsulate(ct)
+	default:
+		return nil, fmt.Errorf("tls: unsupported KEX KEM algorithm %q", alg)
+	}
+}
diff -ruN .build/pq-baseline/src/crypto/pq/mlkem.go .build/extracted/go_kemtls/src/crypto/pq/mlkem.go
--- a/src/crypto/pq/mlkem.go	1970-01-01 08:00:00.000000000 +0800
+++ b/src/crypto/pq/mlkem.go	2026-11-22 12:12:51.799397613 +0800
@@ -0,0 +1,136 @@
+package pq
+
+import (
+	"crypto/mlkem"
+	"encoding/asn1"
+	"fmt"
+)
+
+// goKEMBackend 是纯 Go 的 ML-KEM 后端。C 注册表仍是默认入口；ML-KEM 由
+// Go 标准库实现，避免为了一个算法引入 C 依赖。
+type goKEMBackend struct {
+	name    string
+	version string
+	oid     asn1.ObjectIdentifier
+	level   int
+}
+
+func (b *goKEMBackend) publicKeySize() int {
+	if b.level == 1024 {
+		return 1568
+	}
+	return 1184
+}
+
+func (b *goKEMBackend) privateKeySize() int { return mlkem.SeedSize }
+func (b *goKEMBackend) ciphertextSize() int {
+	if b.level == 1024 {
+		return 1568
+	}
+	return 1088
+}
+func (b *goKEMBackend) sharedSecretSize() int { return mlkem.SharedKeySize }
+
+func (b *goKEMBackend) generateKey() (pk, sk []byte, err error) {
+	if b.level == 1024 {
+		dk, err := mlkem.GenerateKey1024()
+		if err != nil {
+			return nil, nil, err
+		}
+		return dk.EncapsulationKey().Bytes(), dk.Bytes(), nil
+	}
+	dk, err := mlkem.GenerateKey768()
+	if err != nil {
+		return nil, nil, err
+	}
+	return dk.EncapsulationKey().Bytes(), dk.Bytes(), nil
+}
+
+func (b *goKEMBackend) derivePublic(sk []byte) ([]byte, error) {
+	if b.level == 1024 {
+		dk, err := mlkem.NewDecapsulationKey1024(sk)
+		if err != nil {
+			return nil, err
+		}
+		return dk.EncapsulationKey().Bytes(), nil
+	}
+	dk, err := mlkem.NewDecapsulationKey768(sk)
+	if err != nil {
+		return nil, err
+	}
+	return dk.EncapsulationKey().Bytes(), nil
+}
+
+func (b *goKEMBackend) encapsulate(pk []byte) (ct, ss []byte, err error) {
+	if len(pk) != b.publicKeySize() {
+		return nil, nil, fmt.Errorf("%w: public key %d != %d", ErrLength, len(pk), b.publicKeySize())
+	}
+	var ek interface {
+		Encapsulate() ([]byte, []byte)
+	}
+	if b.level == 1024 {
+		k, err := mlkem.NewEncapsulationKey1024(pk)
+		if err != nil {
+			return nil, nil, err
+		}
+		ek = k
+	} else {
+		k, err := mlkem.NewEncapsulationKey768(pk)
+		if err != nil {
+			return nil, nil, err
+		}
+		ek = k
+	}
+	ss, ct = ek.Encapsulate()
+	return ct, ss, nil
+}
+
+func (b *goKEMBackend) decapsulate(sk, ct []byte) ([]byte, error) {
+	if len(ct) != b.ciphertextSize() {
+		return nil, fmt.Errorf("%w: ciphertext %d != %d", ErrLength, len(ct), b.ciphertextSize())
+	}
+	if b.level == 1024 {
+		dk, err := mlkem.NewDecapsulationKey1024(sk)
+		if err != nil {
+			return nil, err
+		}
+		return dk.Decapsulate(ct)
+	}
+	dk, err := mlkem.NewDecapsulationKey768(sk)
+	if err != nil {
+		return nil, err
+	}
+	return dk.Decapsulate(ct)
+}
+
+var goKEMAlgorithms = []*goKEMBackend{
+	{
+		name:    "ML-KEM-768",
+		version: "FIPS 203",
+		oid:     asn1.ObjectIdentifier{2, 16, 840, 1, 101, 3, 4, 4, 2},
+		level:   768,
+	},
+	{
+		name:    "ML-KEM-1024",
+		version: "FIPS 203",
+		oid:     asn1.ObjectIdentifier{2, 16, 840, 1, 101, 3, 4, 4, 3},
+		level:   1024,
+	},
+}
+
+func lookupGoKEM(name string) *Algorithm {
+	for _, b := range goKEMAlgorithms {
+		if b.name == name {
+			return &Algorithm{goKEM: b}
+		}
+	}
+	return nil
+}
