+// kemSecretInput 把两段 KEM 共享秘密编码成无歧义的输入：
+// uint16(ssServer)||ssServer||uint16(ssClient)||ssClient。
+func kemSecretInput(ssServer, ssClient []byte) []byte {
+	out := make([]byte, 0, 4+len(ssServer)+len(ssClient))
+	for _, ss := range [][]byte{ssServer, ssClient} {
+		out = append(out, byte(len(ss)>>8), byte(len(ss)))
+		out = append(out, ss...)
+	}
+	return out
+}
