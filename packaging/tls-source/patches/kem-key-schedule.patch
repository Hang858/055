+// WithKEMSecret mixes an external shared secret (the KEM certificate secrets)
+// into the master secret. TLS 1.3's standard schedule does not have a hook for
+// this, so the KEM mode replaces the master secret with
+// HKDF-Extract(salt=master, IKM=ssServer||ssClient) before deriving application
+// traffic secrets. Handshake traffic secrets are intentionally unaffected: the
+// server sends its Finished before it can know the client's KEM contribution.
+func (s *MasterSecret) WithKEMSecret(ikm []byte) *MasterSecret {
+	if len(ikm) == 0 {
+		return s
+	}
+	return &MasterSecret{
+		secret: extract(s.hash, ikm, s.secret),
+		hash:   s.hash,
+	}
+}
