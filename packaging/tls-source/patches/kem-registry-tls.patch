+func QuantumDecryptionWithLocalKeyAlg(kem []byte, keyType, algName string) ([]byte, error) {
+	if algName == "" {
+		return QuantumDecryptionWithLocalKey(kem, keyType)
+	}
+	alg, err := pq.Lookup(algName)
