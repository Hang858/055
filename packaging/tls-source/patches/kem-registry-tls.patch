+func encryptionFromCertWithPQ(cert *x509.Certificate, algName string) ([]byte, []byte, error) {
+	alg, err := pq.Lookup(algName)
+	if err != nil {
+		return nil, nil, fmt.Errorf("KEM 算法未注册: %s: %w", algName, err)
+	}
+	if alg.Kind() != pq.KindKEM {
+		return nil, nil, fmt.Errorf("算法 %s 不是 KEM", algName)
+	}
+	var raw []byte
+	for _, ext := range cert.Extensions {
+		if ext.Id.Equal(OIDQuantumKEMPublicKey) {
+			raw = ext.Value
+			break
+		}
+	}
+	if len(raw) == 0 {
+		return nil, nil, fmt.Errorf("证书中未找到 KEM 公钥扩展 .1.0")
