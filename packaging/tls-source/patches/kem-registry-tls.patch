+	pub, err := alg.ParsePublicKey(raw)
+	if err != nil {
+		return nil, nil, fmt.Errorf("解析 KEM 公钥失败: %w", err)
+	}
+	ct, ss, err := alg.Encapsulate(pub)
+	if err != nil {
+		return nil, nil, fmt.Errorf("KEM 封装失败: %w", err)
+	}
+	return ct, ss, nil
+}
