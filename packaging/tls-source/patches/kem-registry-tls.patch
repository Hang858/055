+		return nil, fmt.Errorf("解析 KEM 私钥失败: %v", err)
+	}
+	ss, err := alg.Decapsulate(priv, kem)
+	if err != nil {
+		return nil, fmt.Errorf("KEM 解封装失败: %v", err)
+	}
