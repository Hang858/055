+// kemFinishedHash binds both KEM certificate secrets to the client Finished.
+// It is used only in the private KEM-certificate mode; the application traffic
+// keys remain the standard TLS 1.3 ECDHE-derived keys.
+func (c *cipherSuiteTLS13) kemFinishedHash(baseKey, ssServer, ssClient []byte, transcript hash.Hash) []byte {
+	h := c.hash.New()
+	h.Write([]byte("KEMTLS client finished"))
+	h.Write(ssServer)
+	h.Write(ssClient)
+	mac := hmac.New(c.hash.New, baseKey)
+	mac.Write(h.Sum(nil))
+	mixed := mac.Sum(nil)
+	finishedKey := tls13.ExpandLabel(c.hash.New, mixed, "finished", nil, c.hash.Size())
 	verifyData := hmac.New(c.hash.New, finishedKey)
 	verifyData.Write(transcript.Sum(nil))
 	return verifyData.Sum(nil)
