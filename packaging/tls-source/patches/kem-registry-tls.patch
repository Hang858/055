+// KEMAlgorithmFromCert returns the KEM algorithm name from extension .1.4.
+// An empty name means the legacy Kyber768 certificate without an algorithm tag.
+func KEMAlgorithmFromCert(cert *x509.Certificate) (string, error) {
+	if cert == nil {
+		return "", fmt.Errorf("证书为空")
+	}
+	for _, ext := range cert.Extensions {
+		if !ext.Id.Equal(OIDQuantumKEMAlgorithm) {
+			continue
+		}
+		var oid asn1.ObjectIdentifier
+		rest, err := asn1.Unmarshal(ext.Value, &oid)
+		if err != nil || len(rest) != 0 {
+			return "", fmt.Errorf("解析 KEM 算法扩展失败: %v", err)
+		}
+		alg, err := pq.ByOID(oid)
+		if err != nil {
+			return "", fmt.Errorf("未知 KEM 算法 OID %s: %w", oid, err)
+		}
+		if alg.Kind() != pq.KindKEM {
+			return "", fmt.Errorf("OID %s 不是 KEM 算法", oid)
+		}
+		return alg.Name(), nil
+	}
+	return "", nil
+}
