+// QuantumAlgorithmFromCert returns the PQ signature algorithm name stored in
+// the certificate's algorithm extension. Legacy certificates default to
+// Dilithium2.
+func pqSignWithAlg(algName string, raw, data []byte) ([]byte, error) {
+	switch algName {
+	case "Dilithium2":
+		var sk mode2.PrivateKey
+		if err := sk.UnmarshalBinary(raw); err != nil {
+			return nil, err
+		}
+		sig := make([]byte, mode2.SignatureSize)
+		mode2.SignTo(&sk, data, sig)
+		return sig, nil
+	case "Dilithium3":
+		var sk mode3.PrivateKey
+		if err := sk.UnmarshalBinary(raw); err != nil {
+			return nil, err
+		}
+		sig := make([]byte, mode3.SignatureSize)
+		mode3.SignTo(&sk, data, sig)
+		return sig, nil
+	case "Dilithium5":
+		var sk mode5.PrivateKey
+		if err := sk.UnmarshalBinary(raw); err != nil {
+			return nil, err
+		}
+		sig := make([]byte, mode5.SignatureSize)
+		mode5.SignTo(&sk, data, sig)
+		return sig, nil
+	}
+	id, err := slhdsa.IDByName(algName)
+	if err != nil {
+		return nil, err
+	}
+	scheme := id.Scheme()
+	sk, err := scheme.UnmarshalBinaryPrivateKey(raw)
+	if err != nil {
+		return nil, err
+	}
+	sig := scheme.Sign(sk, data, nil)
+	if len(sig) != scheme.SignatureSize() {
+		return nil, fmt.Errorf("SLH-DSA 签名长度异常: %d", len(sig))
+	}
+	return sig, nil
+}
+
+func pqVerifyWithAlg(algName string, raw, data, sig []byte) (bool, error) {
+	switch algName {
+	case "Dilithium2":
+		var pk mode2.PublicKey
+		if err := pk.UnmarshalBinary(raw); err != nil {
+			return false, err
+		}
+		return mode2.Verify(&pk, data, sig), nil
+	case "Dilithium3":
+		var pk mode3.PublicKey
+		if err := pk.UnmarshalBinary(raw); err != nil {
+			return false, err
+		}
+		return mode3.Verify(&pk, data, sig), nil
+	case "Dilithium5":
+		var pk mode5.PublicKey
+		if err := pk.UnmarshalBinary(raw); err != nil {
+			return false, err
+		}
+		return mode5.Verify(&pk, data, sig), nil
+	}
+	id, err := slhdsa.IDByName(algName)
+	if err != nil {
+		return false, err
+	}
+	scheme := id.Scheme()
+	pk, err := scheme.UnmarshalBinaryPublicKey(raw)
+	if err != nil {
+		return false, err
+	}
+	return scheme.Verify(pk, data, sig, nil), nil
+}
+
+func QuantumAlgorithmFromCert(cert *x509.Certificate) (string, error) {
+	for _, ext := range cert.Extensions {
+		if !ext.Id.Equal(OIDQuantumAlgorithm) {
+			continue
+		}
+		var oid asn1.ObjectIdentifier
+		if rest, err := asn1.Unmarshal(ext.Value, &oid); err != nil || len(rest) != 0 {
+			return "", fmt.Errorf("解析抗量子算法扩展失败")
+		}
+		for name, want := range pqSigAlgOIDs {
+			if oid.Equal(want) {
+				return name, nil
+			}
+		}
+		return "", fmt.Errorf("未知抗量子算法 OID: %s", oid)
+	}
+	return "Dilithium2", nil
+}
+
+// QuantumSignWithLocalKeyAlg signs data with the named PQ signature algorithm.
+func QuantumSignWithLocalKeyAlg(data []byte, keyType, algName string) ([]byte, error) {
+	if algName == "" {
+		algName = "Dilithium2"
+	}
+	raw, err := os.ReadFile(keyType)
+	if err != nil {
+		return nil, fmt.Errorf("读取抗量子私钥文件失败: %v", err)
+	}
+	sig, err := pqSignWithAlg(algName, raw, data)
+	if err != nil {
+		return nil, fmt.Errorf("抗量子签名失败: %v", err)
+	}
+	log.Printf("抗量子私钥已加载: %s, 算法: %s", keyType, algName)
+	log.Printf("✅ 使用 %s 抗量子私钥签名成功，签名大小: %d 字节", keyType, len(sig))
+	return append([]byte(nil), sig...), nil
+}
+
+// VerifyQuantumSignatureFromCertAlg verifies with the named PQ algorithm. If
+// algName is empty, the algorithm extension on the certificate is used.
+func VerifyQuantumSignatureFromCertAlg(cert *x509.Certificate, data, signature []byte, algName string) (bool, error) {
+	if cert == nil {
+		return false, fmt.Errorf("证书为空")
+	}
+	if algName == "" {
+		var err error
+		algName, err = QuantumAlgorithmFromCert(cert)
+		if err != nil {
+			return false, err
+		}
+	}
+	var raw []byte
+	for _, ext := range cert.Extensions {
+		if ext.Id.Equal(OIDQuantumSIGPublicKey) {
+			raw = ext.Value
+			break
+		}
+	}
+	if len(raw) == 0 {
+		return false, fmt.Errorf("证书中未找到抗量子公钥扩展")
+	}
+	ok, err := pqVerifyWithAlg(algName, raw, data, signature)
+	if err != nil {
+		return false, fmt.Errorf("抗量子签名验证失败: %v", err)
+	}
+	if !ok {
+		return false, fmt.Errorf("抗量子签名验证失败")
+	}
+	return true, nil
+}
