 // IsDilithiumScheme returns true if the signature scheme is Dilithium.
 func IsDilithiumScheme(scheme SignatureScheme) bool {
-	return scheme == DILITHIUM2withSHA512
+	switch scheme {
+	case DILITHIUM2withSHA512, DILITHIUM3withSHA512, DILITHIUM5withSHA512:
+		return true
+	}
+	return false
+}
+
+func IsSLHDSAScheme(scheme SignatureScheme) bool {
+	switch scheme {
+	case SLHDSASHA2_128s, SLHDSASHA2_128f,
+		SLHDSASHA2_192s, SLHDSASHA2_192f,
+		SLHDSASHA2_256s, SLHDSASHA2_256f:
+		return true
+	}
+	return false
+}
+
+func IsPQSignatureScheme(scheme SignatureScheme) bool {
+	return IsDilithiumScheme(scheme) || IsSLHDSAScheme(scheme)
+}
+
+func PQSchemeName(scheme SignatureScheme) string {
+	switch scheme {
+	case DILITHIUM2withSHA512:
+		return "Dilithium2"
+	case DILITHIUM3withSHA512:
+		return "Dilithium3"
+	case DILITHIUM5withSHA512:
+		return "Dilithium5"
+	case SLHDSASHA2_128s:
+		return "SLH-DSA-SHA2-128s"
+	case SLHDSASHA2_128f:
+		return "SLH-DSA-SHA2-128f"
+	case SLHDSASHA2_192s:
+		return "SLH-DSA-SHA2-192s"
+	case SLHDSASHA2_192f:
+		return "SLH-DSA-SHA2-192f"
+	case SLHDSASHA2_256s:
+		return "SLH-DSA-SHA2-256s"
+	case SLHDSASHA2_256f:
+		return "SLH-DSA-SHA2-256f"
+	}
+	return ""
+}
+
+func PQSchemeByName(name string) (SignatureScheme, bool) {
+	switch name {
+	case "Dilithium2":
+		return DILITHIUM2withSHA512, true
+	case "Dilithium3":
+		return DILITHIUM3withSHA512, true
+	case "Dilithium5":
+		return DILITHIUM5withSHA512, true
+	case "SLH-DSA-SHA2-128s":
+		return SLHDSASHA2_128s, true
+	case "SLH-DSA-SHA2-128f":
+		return SLHDSASHA2_128f, true
+	case "SLH-DSA-SHA2-192s":
+		return SLHDSASHA2_192s, true
+	case "SLH-DSA-SHA2-192f":
+		return SLHDSASHA2_192f, true
+	case "SLH-DSA-SHA2-256s":
+		return SLHDSASHA2_256s, true
+	case "SLH-DSA-SHA2-256f":
+		return SLHDSASHA2_256f, true
+	}
+	return 0, false
 }
 
