+// protocolTypeList 返回去重后的本端支持列表，首项为首选。
+func (c *Config) protocolTypeList() []uint16 {
+	list := c.ProtocolTypes
+	if len(list) == 0 {
+		list = []uint16{c.ProtocolType}
+	}
+	seen := make(map[uint16]bool, len(list))
+	out := make([]uint16, 0, len(list)+1)
+	for _, t := range list {
+		if !protocolTypeValid(t) || seen[t] {
+			continue
+		}
+		seen[t] = true
+		out = append(out, t)
+	}
+	// 兼容模式允许回退到经典 TLS：把 0 放到列表末尾，作为最低优先级候选。
+	if len(c.ProtocolTypes) > 0 && c.ModeCompatibilityFlag && !seen[ClassicAKE] {
+		out = append(out, ClassicAKE)
+	}
+	if len(out) == 0 {
+		out = append(out, ClassicAKE)
+	}
+	return out
+}
+
+// protocolTypePrimary 返回列表首项，即本端首选类型。
+func (c *Config) protocolTypePrimary() uint16 {
+	return c.protocolTypeList()[0]
+}
+
+// protocolTypeStrict 返回本端是否强制首选类型。设置 ProtocolTypes 时按论文
+// 语义由 ModeCompatibilityFlag 取反；未设置时沿用旧的 ProtocolTypeStrict。
+func (c *Config) protocolTypeStrict() bool {
+	if len(c.ProtocolTypes) > 0 {
+		return !c.ModeCompatibilityFlag
+	}
+	return c.ProtocolTypeStrict == 1
+}
+
+// protocolTypeWireStrict 返回扩展 0xFFF2 的取值（1=强制，0=可协商）。
+func (c *Config) protocolTypeWireStrict() uint16 {
+	if c.protocolTypeStrict() {
+		return 1
+	}
+	return 0
+}
