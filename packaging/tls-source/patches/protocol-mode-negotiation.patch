+// protocolTypeAuth 返回组合编号中的认证部分（0/10/20）。
+func protocolTypeAuth(t uint16) uint16 { return (t / 10) * 10 }
+
+// protocolTypeKEX 返回组合编号中的密钥交换部分（0..3）。
+func protocolTypeKEX(t uint16) uint16 { return t % 10 }
+
+// protocolTypeValid 判断组合编号是否落在已定义的取值范围内。
+func protocolTypeValid(t uint16) bool {
+	// 0..3 是经典证书认证下的密钥交换变体（经典/混合/HRR/参数后移）。
+	if t <= QuantumSupportServerKeyGen {
+		return true
+	}
+	auth := protocolTypeAuth(t)
+	kex := protocolTypeKEX(t)
+	if auth != QuantumSupportSignCert && auth != QuantumSupportKemCert {
+		return false
+	}
+	return kex <= QuantumSupportServerKeyGen
+}
