+package tls
+
+import "testing"
+
+func TestProtocolTypeValid(t *testing.T) {
+	valid := []uint16{0, 1, 2, 3, 10, 11, 12, 13, 20, 21, 22, 23}
+	for _, tt := range valid {
+		if !protocolTypeValid(tt) {
+			t.Errorf("protocolTypeValid(%d) = false, want true", tt)
+		}
+	}
+	invalid := []uint16{4, 5, 9, 14, 19, 24, 30, 99}
+	for _, tt := range invalid {
+		if protocolTypeValid(tt) {
+			t.Errorf("protocolTypeValid(%d) = true, want false", tt)
+		}
+	}
+}
+
+func TestProtocolTypeList(t *testing.T) {
+	tests := []struct {
+		name string
+		c    *Config
+		want []uint16
+	}{
+		{
+			name: "legacy single type",
+			c:    &Config{ProtocolType: 11},
+			want: []uint16{11},
+		},
+		{
+			name: "explicit list keeps order",
+			c:    &Config{ProtocolTypes: []uint16{23, 20}},
+			want: []uint16{23, 20},
+		},
+		{
+			name: "dedupe",
+			c:    &Config{ProtocolTypes: []uint16{13, 13, 0}},
+			want: []uint16{13, 0},
+		},
+		{
+			name: "compat appends classic fallback",
+			c:    &Config{ProtocolTypes: []uint16{13}, ModeCompatibilityFlag: true},
+			want: []uint16{13, 0},
+		},
+		{
+			name: "strict keeps only advertised",
+			c:    &Config{ProtocolTypes: []uint16{13}, ModeCompatibilityFlag: false},
+			want: []uint16{13},
+		},
+		{
+			name: "invalid entries ignored",
+			c:    &Config{ProtocolTypes: []uint16{99, 21}},
+			want: []uint16{21},
+		},
+	}
+	for _, tc := range tests {
+		got := tc.c.protocolTypeList()
+		if len(got) != len(tc.want) {
+			t.Fatalf("%s: got %v, want %v", tc.name, got, tc.want)
+		}
+		for i := range got {
+			if got[i] != tc.want[i] {
+				t.Fatalf("%s: got %v, want %v", tc.name, got, tc.want)
+			}
+		}
+	}
+}
+
+func TestProtocolTypeStrict(t *testing.T) {
+	if (&Config{ProtocolType: 11}).protocolTypeStrict() {
+		t.Error("legacy zero-value ProtocolTypeStrict must be flexible")
+	}
+	if !(&Config{ProtocolType: 11, ProtocolTypeStrict: 1}).protocolTypeStrict() {
+		t.Error("legacy ProtocolTypeStrict=1 must be strict")
+	}
+	if (&Config{ProtocolTypes: []uint16{11}, ModeCompatibilityFlag: true}).protocolTypeStrict() {
+		t.Error("ModeCompatibilityFlag=true must be flexible")
+	}
+	if !(&Config{ProtocolTypes: []uint16{11}}).protocolTypeStrict() {
+		t.Error("ModeCompatibilityFlag=false with a list must be strict")
+	}
+}
