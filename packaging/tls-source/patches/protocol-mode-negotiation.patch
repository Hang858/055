+// negotiateProtocolType 按论文第 5 章的方式选择交互类型：
+// 客户端列表顺序即优先级；服务端强制模式下只接受本端类型或 ClassicAKE；
+// 选择结果必须来自双方的交集，否则中止握手（防降级）。
+func (hs *serverHandshakeStateTLS13) negotiateProtocolType() error {
+	offered := hs.clientHello.ProtocolTypes
+	if len(offered) == 0 {
+		offered = []uint16{hs.clientHello.ProtocolType}
+	}
+	supported := make(map[uint16]bool)
+	for _, t := range hs.c.config.protocolTypeList() {
+		supported[t] = true
+	}
+	// 经典 TLS 是任何实现都具备的能力，作为最低优先级回退项。
+	supported[ClassicAKE] = true
+
+	clientFlexible := hs.clientHello.ProtocolTypeStrict == 0
+	clientPrimary := offered[0]
+	serverStrict := hs.protocoltypestrict == 1
+
+	var chosen uint16
+	found := false
+	for _, t := range offered {
+		if !protocolTypeValid(t) {
+			hs.c.sendAlert(alertIllegalParameter)
+			return fmt.Errorf("tls: client offered invalid protocol type %d", t)
+		}
+		if t != ClassicAKE && !supported[t] {
+			continue
+		}
+		// 客户端强制模式不能接受非首选类型（0 是允许的回退）。
+		if !clientFlexible && t != clientPrimary && t != ClassicAKE {
+			continue
+		}
+		// 服务端强制模式只接受本端类型（0 是允许的回退）。
+		if serverStrict && t != hs.protocoltype && t != ClassicAKE {
+			continue
+		}
+		if !hs.canRunProtocolType(t) {
+			continue
+		}
+		chosen = t
+		found = true
+		break
+	}
+	if !found {
+		hs.c.sendAlert(alertHandshakeFailure)
+		return fmt.Errorf("tls: no common protocol type (client %v, server %v)", offered, hs.c.config.protocolTypeList())
+	}
+
+	hs.protocoltype = chosen
+	hs.hello.ProtocolType = chosen
+	hs.hello.ProtocolTypeStrict = hs.protocoltypestrict
+	log.Printf("协议类型协商: client=%v strict=%d -> selected=%d", offered, hs.clientHello.ProtocolTypeStrict, chosen)
+	return nil
+}
+
+// canRunProtocolType 检查服务端是否具备运行某组合的配置能力。
+func (hs *serverHandshakeStateTLS13) canRunProtocolType(t uint16) bool {
+	if t == ClassicAKE {
+		return true
+	}
+	c := hs.c
+	switch protocolTypeKEX(t) {
+	case ClassicAKE:
+		// 经典密钥交换，不需要额外的 PQ 公钥。
+	case QuantumSupportKEX:
+		if len(hs.clientHello.pqPublicKey) == 0 {
+			return false
+		}
+	case GoogleHelloRetryRequest, QuantumSupportServerKeyGen:
+		// 这两类由服务端生成后移参数，不需要客户端预送 PQ 公钥。
+	}
+
+	switch protocolTypeAuth(t) {
+	case ClassicSign:
+		return true
+	case QuantumSupportSignCert:
+		// 客户端若通过 signature_algorithms_cert 明确声明了证书验签算法，
+		// 必须包含至少一种 PQ 签名，否则不能选择 PQ 证书认证。
+		if len(hs.clientHello.supportedSignatureAlgorithmsCert) > 0 {
+			hasPQ := false
+			for _, s := range hs.clientHello.supportedSignatureAlgorithmsCert {
+				if IsPQSignatureScheme(s) {
+					hasPQ = true
+					break
+				}
+			}
+			if !hasPQ {
+				return false
+			}
+		}
+		if c.config.KEMTLSSigAlg != "" || c.config.KEMTLSSigKey != "" {
+			return true
+		}
+		certificate, err := c.config.getCertificate(clientHelloInfo(hs.ctx, c, hs.clientHello))
+		if err != nil || len(certificate.Certificate) == 0 {
+			return false
+		}
+		leaf, err := globalCertCache.newCert(certificate.Certificate[0])
+		if err != nil {
+			return false
+		}
+		return myx509.CheckQuantumResistanceSupport(leaf)
+	case QuantumSupportKemCert:
+		// KEM 证书模式需要双向证书：服务端要向客户端证书封装密文。
+		return c.config.ClientAuth >= RequestClientCert
+	}
+	return false
+}
