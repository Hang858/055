--- a/src/crypto/myx509/pq_chain_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/src/crypto/myx509/pq_chain_test.go	2026-11-20 10:43:49.093769886 +0800
@@ -0,0 +1,124 @@
+package myx509
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"math/big"
+	"testing"
+	"time"
+
+	mode2 "github.com/cloudflare/circl/sign/dilithium/mode2"
+)
+
+// dualSignTest 复制 pqcertlab 的两阶段签名：先签不带 .1.2 的原型证书，
+// 用 CSI 生成 PQ 签名，再把 .1.2 加入最终证书。
+func dualSignTest(t *testing.T, template, parent *x509.Certificate, pub *rsa.PublicKey, parentKey *rsa.PrivateKey, pqPriv []byte) []byte {
+	t.Helper()
+	protoDER, err := x509.CreateCertificate(rand.Reader, template, parent, pub, parentKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	proto, err := x509.ParseCertificate(protoDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	csi, err := CertificateSigningInput(proto)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sig, err := pqSignWithAlg("Dilithium2", pqPriv, csi)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template.ExtraExtensions = append(template.ExtraExtensions, pkix.Extension{Id: OIDQuantumSignature, Value: sig})
+	der, err := x509.CreateCertificate(rand.Reader, template, parent, pub, parentKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return der
+}
+
+func TestPQCertificateChain(t *testing.T) {
+	rootRSA, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rootPub, rootPriv, err := mode2.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rootPrivRaw, err := rootPriv.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	algDER, err := asn1.Marshal(pqSigAlgOIDs["Dilithium2"])
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	root := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "PQ Root"},
+		NotBefore:             now.Add(-time.Hour),
+		NotAfter:              now.Add(time.Hour),
+		IsCA:                  true,
+		BasicConstraintsValid: true,
+		KeyUsage:              x509.KeyUsageCertSign,
+		ExtraExtensions: []pkix.Extension{
+			{Id: OIDQuantumSIGPublicKey, Value: rootPub.Bytes()},
+			{Id: OIDQuantumAlgorithm, Value: algDER},
+		},
+	}
+	rootDER := dualSignTest(t, root, root, &rootRSA.PublicKey, rootRSA, rootPrivRaw)
+	rootCert, err := x509.ParseCertificate(rootDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	leafRSA, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafPub, _, err := mode2.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject:      pkix.Name{CommonName: "PQ Leaf"},
+		NotBefore:    now.Add(-time.Hour),
+		NotAfter:     now.Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtraExtensions: []pkix.Extension{
+			{Id: OIDQuantumSIGPublicKey, Value: leafPub.Bytes()},
+			{Id: OIDQuantumAlgorithm, Value: algDER},
+		},
+	}
+	leafDER := dualSignTest(t, leaf, rootCert, &leafRSA.PublicKey, rootRSA, rootPrivRaw)
+	leafCert, err := x509.ParseCertificate(leafDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err := VerifyCertificateChainPQ([]*x509.Certificate{leafCert}, []*x509.Certificate{rootCert}); err != nil {
+		t.Fatalf("chain verification failed: %v", err)
+	}
+	if err := VerifyQuantumSignature(rootCert, rootCert); err != nil {
+		t.Fatalf("root self verification failed: %v", err)
+	}
+
+	tampered := *leafCert
+	tampered.Extensions = append([]pkix.Extension(nil), leafCert.Extensions...)
+	for i := range tampered.Extensions {
+		if tampered.Extensions[i].Id.Equal(OIDQuantumSignature) {
+			tampered.Extensions[i].Value = append([]byte(nil), tampered.Extensions[i].Value...)
+			tampered.Extensions[i].Value[0] ^= 0xff
+		}
+	}
+	if err := VerifyQuantumSignature(&tampered, rootCert); err == nil {
+		t.Fatal("tampered PQ signature must be rejected")
+	}
+}
