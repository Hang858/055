--- a/src/crypto/tls/kem_message_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/src/crypto/tls/kem_message_test.go	2026-11-20 17:07:23.139354414 +0800
@@ -0,0 +1,43 @@
+package tls
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestKEMEncapsulationRoundTrip(t *testing.T) {
+	ct := bytes.Repeat([]byte{0xa5}, 32)
+	msg := &kemEncapsulationMsg{ciphertext: ct}
+	raw, err := msg.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if raw[0] != typeKEMEncapsulation {
+		t.Fatalf("message type = %d, want %d", raw[0], typeKEMEncapsulation)
+	}
+	var got kemEncapsulationMsg
+	if !got.unmarshal(raw) {
+		t.Fatal("unmarshal failed")
+	}
+	if !bytes.Equal(got.ciphertext, ct) {
+		t.Fatal("ciphertext changed")
+	}
+}
+
+func TestKEMEncapsulationRejectsTruncated(t *testing.T) {
+	msg := &kemEncapsulationMsg{ciphertext: bytes.Repeat([]byte{0x5a}, 32)}
+	raw, err := msg.marshal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got kemEncapsulationMsg
+	if got.unmarshal(raw[:len(raw)-1]) {
+		t.Fatal("truncated message must be rejected")
+	}
+	raw[3] = 0xff
+	raw[2] = 0xff
+	raw[1] = 0x01
+	if got.unmarshal(raw) {
+		t.Fatal("oversized length must be rejected")
+	}
+}
