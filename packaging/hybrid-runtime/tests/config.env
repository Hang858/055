# TLS 测试脚本配置
# local  ：服务端与客户端都运行在本机（使用 .build 下的程序）
# remote ：服务端运行在远端 Ubuntu 20.04（使用其已安装的运行包），客户端在本机
MODE=local

# 本地程序与证书（相对项目根目录）
BIN_DIR=.build
CERTS_DIR=.build/certs
CAPTURE_IFACE=lo

# 远端运行包（MODE=remote 时填写）
REMOTE_HOST=ubuntu@192.168.1.10
REMOTE_PORT=22
REMOTE_DIR=/opt/pqc-gateway-hybrid

# 用例规模（可按机器性能调整；0 表示保持大纲默认）
PERF_N=200
CONCURRENCY_N=1000
CONCURRENCY_C=50
LOAD_LOOPS=150
NETEM_N=1000
NETEM_C=50
NETEM_FULL=0          # 1=跑四种方案×四档时延；0=只跑 ClassicKEX 四档
RUN_MODE_MATRIX=0     # TLS-1-13 的四模式矩阵，1=执行

# 编译用例使用的 Go（打补丁的 1.22.12）
GO_BIN=.build/go/bin/go
